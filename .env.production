# ============================================================
# 生产构建专属（pnpm build / pnpm preview 加载；覆盖 .env 同名默认值）
#
# ⚠️ VITE_* 变量会被静态打进客户端产物，禁止放任何密钥；
#    本机打包验证的临时覆盖写 .env.production.local（不入库）。
# ============================================================

# 子域名租户解析主域（eTLD+1，如 psy.com）。
# 公网部署必须覆写——留空时子域名解析整级跳过，生产防呆断言会
# console.error（config/tenant/resolve.ts），全站静默落 default 租户
VITE_APP_DOMAIN=

# 私有化部署：覆写为租户 id（如 nist）；公网留空
VITE_PRIVATE_TENANT=
