# ============================================================
# 环境变量模板与总清单（Vite 不会加载本文件，仅作文档）
#
# 文件分层与优先级（后者覆盖前者；*.local 已被 .gitignore 排除）：
#   .env                    全局默认，所有模式加载
#   .env.development        pnpm dev 加载
#   .env.production         pnpm build / preview 加载
#   .env.local              本地全局覆盖（所有模式生效）
#   .env.development.local  本地开发专属覆盖
#   .env.production.local   本地打包验证专属覆盖
#
# 使用：复制对应文件后按环境填写；只有 VITE_ 前缀的变量会暴露给
# 客户端代码（import.meta.env），禁止在任何 env 文件存放密钥。
# ============================================================

# ---- 后端服务 ----
# 业务接口根地址（api/http.ts 的 baseURL）；留空回退 /api 同源转发
VITE_API_BASE_URL=

# ---- 开发代理（仅 dev server：/api、/hubs 转发目标）----
# 留空回退 http://127.0.0.1:8080
VITE_PROXY_TARGET=

# ---- MSW（Mock Service Worker）----
# DEV 下默认开启，联调真实后端时置 '0' 关闭；非 DEV 置 '1' 可强制开启
VITE_USE_MOCK=
# 置 '1' 时所有 mock 接口返回 500，用于验证 error / loading 分支
VITE_MOCK_ERROR=

# ---- AI 对话 ----
# OpenAI 风格 SSE 流式对话地址（api/ai.ts）；留空走本地话术引擎 mock
VITE_AI_CHAT_URL=

# ---- 实时通道 ----
# SignalR hub 地址（realtime/connection.ts）；留空时实时功能静默降级
VITE_SIGNALR_HUB_URL=

# ---- 多租户 ----
# 站点标题默认值（config/tenant/default.ts），全局默认已写在 .env
VITE_APP_TITLE=生涯心旅
# 子域名解析租户用（config/tenant/resolve.ts）：公网=主域如 psy.com；dev=localhost
VITE_APP_DOMAIN=
# 私有化部署构建期锁定租户（公网构建留空；私有化填租户 id 如 nist）
VITE_PRIVATE_TENANT=
