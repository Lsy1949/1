# ============================================================
# 环境变量模板：复制为 .env.development / .env.production 后按环境填写
# ============================================================

# ---- 后端服务 ----
# 业务接口根地址（http.ts 与 tenant loader 的 baseURL），如 http://localhost:8080/api
VITE_API_BASE_URL=

# ---- 登录 mock 开关 ----
# 'true' 时登录走本地 mock（api/mock/auth.ts），否则走真实接口
VITE_USE_MOCK_LOGIN=

# ---- AI 对话 ----
# OpenAI 风格 SSE 流式对话地址；留空时走本地话术引擎 mock（api/ai.ts 自动回落）
VITE_AI_CHAT_URL=

# ---- 实时通道 ----
# SignalR hub 地址（realtime/connection.ts），留空时实时功能静默降级
VITE_SIGNALR_HUB_URL=

# ---- 多租户 ----
# 站点标题（有默认值：生涯心旅）
VITE_APP_TITLE=
# 按域名解析租户用（config/tenant/resolve.ts）
VITE_APP_DOMAIN=
# 指定租户 ID（config/tenant/resolve.ts）
VITE_TENANT_ID=
