# ============================================================
# 开发环境专属（pnpm dev 加载；覆盖 .env 中的同名默认值）
#
# DEV 下 MSW 默认开启，接口全部由 mock 接管；
# 联调真实后端时把 VITE_USE_MOCK 置 '0'（经 vite proxy 转发到后端）。
# 本机个人覆盖写 .env.development.local（不入库，优先级最高）。
# ============================================================

# ---- 后端服务 ----
# 留空 = 同源相对路径 /api（经 vite proxy 转发到 VITE_PROXY_TARGET）；
# 直连后端时填完整地址，如 http://localhost:8080/api
VITE_API_BASE_URL=

# ---- 开发代理（vite.config.ts server.proxy，仅 dev server 生效）----
# /api、/hubs(ws) 的转发目标，留空回退 http://127.0.0.1:8080
VITE_PROXY_TARGET=

# ---- MSW（Mock Service Worker）----
# DEV 下默认开启，联调真实后端时置 '0' 关闭；非 DEV 置 '1' 可强制开启
VITE_USE_MOCK=
# 置 '1' 时所有 mock 接口返回 500，用于验证 error / loading 分支
VITE_MOCK_ERROR=

# ---- AI 对话 ----
# OpenAI 风格 SSE 流式对话地址；留空走本地话术引擎 mock（api/ai.ts 自动回落）
VITE_AI_CHAT_URL=

# ---- 实时通道 ----
# SignalR hub 地址；留空时实时功能静默降级（不影响页面使用）
VITE_SIGNALR_HUB_URL=

# ---- 多租户（覆盖 .env 无默认值的解析开关）----
# dev 固定 localhost：子域名解析在本地开发可用（如 nist.localhost）
VITE_APP_DOMAIN=localhost
# 私有化联调时在此锁定租户 id（如 nist）；平时留空
VITE_PRIVATE_TENANT=
