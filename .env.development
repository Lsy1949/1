# ============================================================
# 开发环境：DEV 下 MSW 默认开启，接口全部由 mock 接管；
# 联调真实后端时把 VITE_USE_MOCK 置 0。
# ============================================================

# ---- 后端服务 ----
# TODO: 填入后端接口根地址，如 http://localhost:8080/api
VITE_API_BASE_URL=

# ---- MSW（Mock Service Worker）----
# DEV 下默认开启，联调真实后端时置 '0' 关闭；非 DEV 置 '1' 可强制开启
VITE_USE_MOCK=
# 置 '1' 时所有 mock 接口返回 500，用于验证 error / loading 分支
VITE_MOCK_ERROR=

# ---- AI 对话 ----
# 留空走本地话术引擎 mock（契约与真实接口一致）
VITE_AI_CHAT_URL=

# ---- 实时通道 ----
# 留空时实时功能静默降级（不影响页面使用）
VITE_SIGNALR_HUB_URL=

# ---- 多租户 ----
VITE_APP_TITLE=生涯心旅
VITE_APP_DOMAIN=localhost
VITE_PRIVATE_TENANT=
