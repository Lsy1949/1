# ============================================================
# 开发环境：后端地址就绪前保持 mock 可跑；填入真实地址后，
# 将 VITE_USE_MOCK_LOGIN 改为 'false' 即切换真实接口。
# ============================================================

# ---- 后端服务 ----
# TODO: 填入后端接口根地址，如 http://localhost:8080/api
VITE_API_BASE_URL=

# ---- 登录 mock 开关 ----
# 开发期默认走本地 mock（后端地址未配置时真实请求会 404）
VITE_USE_MOCK_LOGIN=true

# ---- AI 对话 ----
# 留空走本地话术引擎 mock（契约与真实接口一致）
VITE_AI_CHAT_URL=

# ---- 实时通道 ----
# 留空时实时功能静默降级（不影响页面使用）
VITE_SIGNALR_HUB_URL=

# ---- 多租户 ----
VITE_APP_TITLE=生涯心旅
VITE_APP_DOMAIN=
VITE_TENANT_ID=
